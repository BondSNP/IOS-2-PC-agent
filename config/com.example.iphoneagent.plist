<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.example.iphoneagent</string>

    <key>ProgramArguments</key>
    <array>
      <string>/var/jb/usr/bin/sh</string>
      <string>/var/mobile/agent/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/var/mobile/agent</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>/var/mobile</string>
      <key>PATH</key>
      <string>/var/mobile/agent/venv/bin:/var/jb/usr/bin:/var/jb/usr/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
      <key>PYTHONUNBUFFERED</key>
      <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/mobile/agent/agent.log</string>

    <key>StandardErrorPath</key>
    <string>/var/mobile/agent/agent.err</string>
  </dict>
</plist>
